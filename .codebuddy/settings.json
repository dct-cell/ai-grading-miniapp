{
  "language": "简体中文",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/alembic:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rm -f:*)",
      "Bash(rm -rf tmp:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(ssh:*)",
      "Bash(.venv/bin/alembic downgrade:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/jobs/**)",
      "Read(./tmp/**)"
    ]
  }
}
