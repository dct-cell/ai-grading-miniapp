[Unit]
Description=Encrypted SkyEdu Grader backup
After=mysql.service

[Service]
Type=oneshot
User=grader
Group=grader
EnvironmentFile=/etc/grader/backup.env
ExecStart=/srv/grader/current/ops/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/grader-backup /srv/grader-data
