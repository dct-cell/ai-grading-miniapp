.home {
  padding-top: var(--space-screen-top);
}

.intro {
  position: relative;
  display: flex;
  min-height: 470rpx;
  overflow: hidden;
  align-items: center;
  padding: 24rpx 0 36rpx;
  box-sizing: border-box;
}

.intro__copy {
  position: relative;
  z-index: 2;
  flex: 0 0 44%;
  min-width: 0;
}

.intro__account {
  width: 94rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(185, 201, 192, 0.78);
  border-radius: 50%;
  background: rgba(232, 240, 235, 0.88);
  box-sizing: border-box;
  transform-origin: center;
}

.intro__account-text {
  max-width: 58rpx;
  overflow: hidden;
  color: var(--brand);
  font-size: var(--type-section);
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.intro__title {
  margin-top: 28rpx;
  color: var(--text);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.intro__sub {
  width: 100%;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: var(--type-meta);
  line-height: 1.55;
  white-space: nowrap;
}

.intro__rule {
  width: 88rpx;
  height: 2rpx;
  margin-top: 42rpx;
  background: var(--brand);
}

.intro__promise {
  margin-top: 20rpx;
  color: var(--brand);
  font-size: var(--type-meta);
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}

.intro__visual {
  position: relative;
  z-index: 1;
  flex: 0 0 56%;
  height: 360rpx;
}

.intro__geometry {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  right: -8rpx;
  top: 50%;
  opacity: 1;
  transform: translateY(-50%);
}

.home-state {
  min-height: 310rpx;
}

.skeleton--title {
  width: 42%;
  height: 34rpx;
}

.skeleton--panel {
  height: 210rpx;
  margin-top: 24rpx;
}

.process__item {
  display: flex;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.process__item:last-child {
  border-bottom: 0;
}

.process__no {
  flex: none;
  color: var(--brand);
  font-size: var(--type-caption);
  font-weight: 700;
}

.process__title {
  margin-bottom: 5rpx;
  font-size: var(--type-control);
  font-weight: 600;
}

.standard-strip {
  overflow: hidden;
  border-top: 1rpx solid var(--line);
}

.standard-strip__item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.standard-strip__label,
.recent__title {
  margin-bottom: 6rpx;
  font-size: var(--type-control);
  font-weight: 600;
}

.current {
  position: relative;
  min-height: 240rpx;
  overflow: hidden;
  padding: var(--space-group);
  box-sizing: border-box;
}

.current__copy {
  position: relative;
  z-index: 2;
  width: 68%;
}

.current__standard {
  margin-top: 12rpx;
  font-size: var(--type-section);
  font-weight: 600;
  line-height: 1.35;
}

.current__meta,
.current__eta {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: var(--type-meta);
}

.current__geometry {
  position: absolute;
  width: 300rpx;
  height: 225rpx;
  right: -84rpx;
  bottom: -16rpx;
  opacity: 0.24;
}

.recent {
  min-height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx var(--space-group);
}

.recent > view:first-child {
  flex: 1;
  min-width: 0;
}

.recent__status {
  flex: none;
  align-self: center;
}

.empty-inline {
  padding: 34rpx var(--space-group);
  color: var(--muted);
  font-size: var(--type-meta);
}

.service-note {
  margin-top: 56rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.service-note__title {
  margin-bottom: 10rpx;
  color: var(--text);
  font-size: var(--type-body);
  font-weight: 600;
}
