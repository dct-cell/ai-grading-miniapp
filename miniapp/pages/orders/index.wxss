.orders-page {
  padding-top: var(--space-screen-top);
}

.orders-lead {
  margin: 12rpx 0 40rpx;
}

.orders-lead__title {
  margin-bottom: 8rpx;
  font-size: var(--type-page);
  font-weight: 700;
}

.tabs {
  position: relative;
  display: flex;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.tabs__item {
  position: relative;
  flex: 1;
  text-align: center;
  min-height: 88rpx;
  line-height: 88rpx;
  color: var(--muted);
  border-radius: 14rpx 14rpx 0 0;
  font-size: var(--type-control);
  transition: color var(--motion-fast) ease-out, background-color var(--motion-fast) ease-out, transform var(--motion-fast) ease-out;
}

.tabs__item--on {
  color: var(--brand);
  font-weight: 600;
}

.tabs__item--on::after {
  content: "";
  position: absolute;
  left: 24%;
  right: 24%;
  bottom: -1rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--brand);
}

.orders-list {
  min-height: 200rpx;
}

.orders-loading__row {
  min-height: 180rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--line-soft);
}

.orders-loading__dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.orders-loading__copy {
  flex: 1;
  margin-left: 20rpx;
}

.orders-loading__line {
  width: 72%;
  height: 26rpx;
}

.orders-loading__line--short {
  width: 46%;
  height: 20rpx;
  margin-top: 16rpx;
}

.orders-empty {
  padding: 60rpx 20rpx 30rpx;
  text-align: center;
}

.orders-empty__geometry {
  width: 280rpx;
  height: 180rpx;
  margin: 0 auto 20rpx;
  overflow: hidden;
}

.orders-empty__geometry image {
  width: 100%;
  height: 100%;
  opacity: 0.7;
}

.orders-empty__title {
  margin-bottom: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.center {
  text-align: center;
  padding: 30rpx 0;
}
