.nav-shell {
  width: 100%;
  background: #f6f4ef;
}

.nav {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.nav__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #202320;
  font-size: var(--type-page);
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.nav__title--back {
  font-size: var(--type-section);
  font-weight: 600;
}

.nav__back,
.nav__account {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
}

.nav__back {
  margin-left: -18rpx;
  margin-right: 6rpx;
}

.nav__account {
  flex: none;
  margin-left: auto;
  background: rgba(232, 240, 235, 0.9);
  border: 1rpx solid rgba(185, 201, 192, 0.72);
}

.nav__icon,
.nav__user {
  width: 38rpx;
  height: 38rpx;
}

.nav__account-text {
  color: #285a4a;
  font-size: var(--type-meta);
  font-weight: 600;
}

.nav__back.tap-feedback--active,
.nav__account.tap-feedback--active {
  transform: scale(0.985);
}
