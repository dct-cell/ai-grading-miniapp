page {
  --brand: #285a4a;
  --brand-strong: #1e493c;
  --brand-soft: #e8f0eb;
  --sage: #b9c9c0;
  --text: #202320;
  --muted: #737773;
  --line: #d8d3ca;
  --line-soft: #e8e4dc;
  --bg: #f6f4ef;
  --surface: #fffdfc;
  --surface-soft: #f1f1eb;
  --danger: #b55e50;
  --danger-soft: #f7ebe8;
  --waiting: #a87832;
  --waiting-soft: #f6efe2;
  --ok: #39755f;
  --radius-control: 18rpx;
  --radius-group: 24rpx;
  --space-page: 32rpx;
  --space-group: 28rpx;
  --space-screen-top: 28rpx;
  --space-section: 48rpx;
  --type-caption: 22rpx;
  --type-meta: 24rpx;
  --type-body: 26rpx;
  --type-control: 28rpx;
  --type-section: 30rpx;
  --type-page: 34rpx;
  --motion-fast: 160ms;
  background: var(--bg);
  color: var(--text);
  font-size: var(--type-body);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding: var(--space-screen-top) var(--space-page) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page--with-action {
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--surface);
  border: 1rpx solid rgba(216, 211, 202, 0.82);
  border-radius: var(--radius-group);
  padding: var(--space-group);
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(32, 35, 32, 0.035);
}

.card__title {
  font-size: var(--type-section);
  font-weight: 600;
  line-height: 1.35;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.row__label {
  color: var(--muted);
}

.muted {
  color: var(--muted);
  font-size: var(--type-meta);
  line-height: 1.6;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 20rpx;
  background: var(--brand);
  color: var(--surface);
  border-radius: var(--radius-control);
  text-align: center;
  padding: 20rpx 28rpx;
  font-size: var(--type-control);
  font-weight: 600;
  line-height: 1.25;
  box-sizing: border-box;
  transition: transform var(--motion-fast) ease-out;
}

.btn--ghost {
  background: transparent;
  color: var(--brand);
  border: 1rpx solid rgba(40, 90, 74, 0.42);
}

.btn--danger {
  background: var(--danger-soft);
  color: var(--danger);
  border: 1rpx solid rgba(181, 94, 80, 0.42);
}

.btn[disabled],
.btn--disabled {
  opacity: 0.42;
  pointer-events: none;
}

.tap-feedback {
  transform-origin: center;
  transition: transform var(--motion-fast) ease-out;
}

.tap-feedback--active {
  transform: scale(0.985);
}

.btn.tap-feedback--active {
  transform: scale(0.98);
}

.error {
  color: var(--danger);
  font-size: var(--type-body);
  line-height: 1.55;
  margin-top: 12rpx;
}

.error-panel {
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--danger-soft);
  border: 1rpx solid rgba(181, 94, 80, 0.22);
  border-radius: var(--radius-control);
  padding: 26rpx;
  box-sizing: border-box;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 42rpx 0 20rpx;
  font-size: var(--type-section);
  font-weight: 600;
  line-height: 1.35;
}

.section-title__action {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  color: var(--brand);
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: var(--type-meta);
  font-weight: 600;
}

.surface {
  background: var(--surface);
  border: 1rpx solid rgba(216, 211, 202, 0.82);
  border-radius: var(--radius-group);
  box-shadow: 0 12rpx 30rpx rgba(32, 35, 32, 0.04);
}

.list-surface {
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid rgba(216, 211, 202, 0.82);
  border-radius: var(--radius-group);
  padding: 0 var(--space-group);
  box-shadow: 0 10rpx 28rpx rgba(32, 35, 32, 0.035);
  box-sizing: border-box;
}

.skeleton {
  overflow: hidden;
  position: relative;
  background: #eae8e1;
  border-radius: 12rpx;
}

.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.32);
  animation: skeleton-fade 1.2s ease-in-out infinite alternate;
}

@keyframes skeleton-fade {
  from { opacity: 0.25; }
  to { opacity: 0.78; }
}

.mono-number {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
