GRADER_ENVIRONMENT=staging
GRADER_DATABASE_URL=mysql+pymysql://grader:change-me@127.0.0.1/grader_staging
GRADER_DATA_DIR=/srv/grader-data/staging
GRADER_SESSION_SECRET=replace-with-32-or-more-random-characters
GRADER_WORKER_SHARED_KEY=replace-with-32-or-more-random-characters
GRADER_ADMIN_SHARED_KEY=deprecated-in-phase-07-unused-but-still-parsed-value
GRADER_ADMIN_ORIGIN=https://admin.example.com
GRADER_PRICE_CENTS_PER_PAGE=500
GRADER_SUMMARY_PRICE_CENTS_PER_PAGE=100
GRADER_ANNOTATED_PRICE_CENTS_PER_PAGE=500
GRADER_SUMMARY_REPORT_ENABLED=false
GRADER_MAX_PDF_BYTES=26214400
GRADER_MAX_PDF_PAGES=30
GRADER_QUOTE_TTL_SECONDS=86400
GRADER_ACCEPTANCE_TTL_SECONDS=259200
GRADER_WECHAT_LIVE_MODE=false
GRADER_WECHAT_APP_ID=wx-your-miniapp-id
GRADER_WECHAT_APP_SECRET=replace-with-wechat-app-secret
GRADER_WECHAT_PAY_MERCHANT_ID=1900000001
GRADER_WECHAT_PAY_CERTIFICATE_SERIAL=replace-with-merchant-certificate-serial
GRADER_WECHAT_PAY_PRIVATE_KEY_PATH=/etc/grader/secrets/apiclient_key.pem
GRADER_WECHAT_PAY_PUBLIC_KEY_ID=replace-with-wechatpay-public-key-id
GRADER_WECHAT_PAY_PUBLIC_KEY_PATH=/etc/grader/secrets/wechatpay_public.pem
GRADER_WECHAT_PAY_API_V3_KEY=change-me-api-v3-key-32-bytes!!!
GRADER_WECHAT_PAY_NOTIFY_URL=https://api.skyedumath.com/callbacks/wechat/pay
GRADER_WECHAT_PAY_REFUND_NOTIFY_URL=https://api.skyedumath.com/callbacks/wechat/refund
GRADER_BACKUP_SUCCESS_MARKER=/var/lib/grader-backup/last-success
GRADER_WORKER_RUNTIME_MODE=codex
GRADER_WORKER_CODEX_BIN=codex
GRADER_WORKER_GRADING_TIMEOUT_SECONDS=3600
GRADER_WORKER_MAX_CONCURRENT_JOBS=4
